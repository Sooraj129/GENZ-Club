NODE_ENV=development
PORT=5000

# Supabase → Project Settings → Database → Connection string (URI).
# URL-encode special characters in the password (e.g. ! → %21, @ → %40, # → %23, $ → %24).
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# How often the background session monitor runs (10000–30000 recommended)
SESSION_MONITOR_INTERVAL_MS=15000
LOG_LEVEL=info
