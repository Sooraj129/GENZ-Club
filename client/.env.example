# Local development (copy to client/.env):
#   the API server runs on its own port; the web app calls it directly.
#   It must be listed in the server's CLIENT_ORIGIN for CORS.
VITE_API_URL=http://localhost:5000

# Production builds use client/.env.production instead:
#   VITE_API_URL=        (empty → same domain, e.g. Vercel's /api)
#   VITE_REALTIME=poll   (refresh every 10 s; no WebSockets on Vercel)
