{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --prefix server && npm ci --include=dev --prefix client",
  "buildCommand": "npm run build --prefix server && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/session-monitor", "schedule": "30 18 * * *" }]
}
